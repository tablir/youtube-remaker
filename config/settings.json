{
  "pipeline": {
    "clips_per_second": 4,
    "min_clip_duration": 3,
    "max_clip_duration": 6,
    "clip_resolution": "1920x1080",
    "clip_fps": 30,
    "batch_size": 50,
    "batch_pause_seconds": 30
  },

  "video": {
    "output_format": "mp4",
    "video_codec": "libx264",
    "audio_codec": "aac",
    "audio_bitrate": "192k",
    "crf": 23,
    "preset": "fast"
  },

  "thumbnail": {
    "width": 1280,
    "height": 720,
    "format": "png",
    "max_title_words": 6,
    "font_size": 72,
    "font_color": "white",
    "stroke_color": "black",
    "stroke_width": 3
  },

  "voice": {
    "default_engine": "edge-tts",
    "edge_tts_voice": "en-US-GuyNeural",
    "edge_tts_rate": "+0%",
    "edge_tts_volume": "+0%",
    "max_chars_per_request": 2500
  },

  "whisper": {
    "model": "medium",
    "device": "cpu",
    "compute_type": "int8",
    "beam_size": 5,
    "language": "en",
    "vad_filter": true
  },

  "footage": {
    "sources": {
      "travel": ["pexels", "pixabay"],
      "historical": ["archive_org", "wikipedia_commons"],
      "educational": ["pexels", "pixabay", "storyblocks"],
      "mixed": ["pexels", "pixabay", "archive_org", "wikipedia_commons"]
    },
    "cache_enabled": true,
    "cache_db": "/data/cache/footage_cache.db",
    "preferred_resolution": "1920x1080",
    "min_resolution": "1280x720",
    "orientation": "horizontal"
  },

  "paths": {
    "output": "/data/output",
    "cache": "/data/cache",
    "temp": "/data/temp",
    "logs": "/data/logs",
    "models": "/data/models"
  },

  "retry": {
    "max_attempts": 3,
    "backoff_seconds": 5
  },

  "logging": {
    "level": "INFO",
    "format": "json"
  }
}
