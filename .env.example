# ============================================
# YouTube Remaker — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
# cp .env.example .env
#
# NEVER commit .env to GitHub!
# .env is listed in .gitignore
# ============================================

# ============================================
# Traefik / SSL
# ============================================
# Email for Let's Encrypt SSL certificate notifications
ACME_EMAIL=your@email.com

# Cloudflare API token for DNS-01 ACME challenge
# Required scopes: Zone → DNS → Edit (for zone serial.tv)
# Create at: dash.cloudflare.com → My Profile → API Tokens → Create Token
CF_API_TOKEN=your_cloudflare_token_here

# ============================================
# n8n
# ============================================
# Your domain for n8n (must match DNS record)
N8N_HOST=ops.serial.tv

# Random 32+ character string for encrypting credentials
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your_random_32_char_string_here

# n8n admin login
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_strong_password_here

# ============================================
# PostgreSQL
# ============================================
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your_strong_db_password_here

# ============================================
# IP Whitelist (Traefik)
# ============================================
# Only these IPs can access ops.serial.tv
# Your IP range — update if your IP changes
ALLOWED_IPS=92.40.110.0/24

# ============================================
# AI APIs (called by n8n HTTP Request nodes)
# ============================================
CLAUDE_API_KEY=sk-ant-your_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ============================================
# Stock Footage APIs
# ============================================
PEXELS_API_KEY=your_pexels_key_here
PIXABAY_API_KEY=your_pixabay_key_here
STORYBLOCKS_API_KEY=your_storyblocks_key_here

# ============================================
# YouTube Data API
# ============================================
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# ============================================
# Pipeline settings
# ============================================
# Average seconds per stock footage clip
CLIPS_PER_SECOND=4

# Default voice engine: edge-tts or elevenlabs
DEFAULT_VOICE=edge-tts

# Whisper model size: tiny, base, small, medium, large
# medium = best balance of speed and accuracy on CPU
WHISPER_MODEL=medium
